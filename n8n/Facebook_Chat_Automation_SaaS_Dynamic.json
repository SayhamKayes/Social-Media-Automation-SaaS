    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v27.0/me/messages",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "access_token",
              "value": "={{ $('Get Client Business Config').first().json.page_access_token || 'FALLBACK_OR_DEFAULT_TOKEN' }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ \n  (() => {\n    function makeUnicodeBold(str) {\n      if (!str) return '';\n      return str.replace(/\\*\\*(.*?)\\*\\*/g, (match, text) => {\n        return text.split('').map(char => {\n          const code = char.charCodeAt(0);\n          if (code >= 65 && code <= 90) return String.fromCodePoint(0x1D5D4 + (code - 65));\n          if (code >= 97 && code <= 122) return String.fromCodePoint(0x1D5EE + (code - 97));\n          if (code >= 48 && code <= 57) return String.fromCodePoint(0x1D7EC + (code - 48));\n          return char;\n        }).join('');\n      });\n    }\n\n    return JSON.stringify({\n      recipient: {\n        id: $('Webhook').first().json.body.entry[0].messaging[0].sender.id\n      },\n      messaging_type: \"RESPONSE\",\n      message: {\n        text: makeUnicodeBold($json.output)\n      }\n    });\n  })()\n}}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
